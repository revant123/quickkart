POSTGRES_USER=quickkart
POSTGRES_PASSWORD=quickkart_dev_pw
POSTGRES_DB=quickkart
JWT_SECRET=replace-me-with-a-random-string-of-at-least-32-characters

# Razorpay TEST mode keys (dashboard.razorpay.com -> Test Mode -> API Keys).
# Leave empty to use QuickKart's built-in test gateway instead. Never commit real keys:
# this .env file is in .gitignore, .env.example is not.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Only needed if you set up a webhook in the Razorpay dashboard (needs a public URL)
RAZORPAY_WEBHOOK_SECRET=
