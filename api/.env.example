PORT=4000
DATABASE_URL=postgres://quickkart:quickkart_dev_pw@localhost:5432/quickkart
JWT_SECRET=paste-the-same-long-secret-as-in-the-root-env-file
COOKIE_SECURE=false
NODE_ENV=development
# Emails and SMS: Mailpit from docker compose (inbox at http://localhost:8025).
# Leave SMTP_URL empty to print messages in this terminal instead.
SMTP_URL=smtp://localhost:1025
APP_URL=http://localhost:5173
REQUIRE_VERIFIED_EMAIL=true
# Razorpay TEST keys, or empty for the built-in test gateway
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
